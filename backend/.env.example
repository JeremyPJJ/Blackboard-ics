# Base de datos
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=plataforma_virtual

# JWT
JWT_SECRET=plataforma-virtual-secret-2026
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=plataforma-virtual-refresh-secret-2026
REFRESH_TOKEN_EXPIRATION=7d

# Archivos
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Servidor
PORT=3000
NODE_ENV=development
